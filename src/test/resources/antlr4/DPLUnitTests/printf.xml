<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root>
    <transformStatement>
        <value>|</value>
        <makeresultsTransformation>
            <value>makeresults</value>
            <t_makeresults_countParameter>
                <value>count=</value>
                <numberType>
                    <value>1</value>
                </numberType>
            </t_makeresults_countParameter>
        </makeresultsTransformation>
        <transformStatement>
            <value>|</value>
            <evalTransformation>
                <value>eval</value>
                <t_eval_evalParameter>
                    <fieldType>
                        <value>r</value>
                    </fieldType>
                    <value>=</value>
                    <evalStatement>
                        <evalNumberType>
                            <value>4</value>
                        </evalNumberType>
                    </evalStatement>
                </t_eval_evalParameter>
            </evalTransformation>
            <transformStatement>
                <value>|</value>
                <evalTransformation>
                    <value>eval</value>
                    <t_eval_evalParameter>
                        <fieldType>
                            <value>Area</value>
                        </fieldType>
                        <value>=</value>
                        <evalStatement>
                            <evalStatement>
                                <subEvalStatement>
                                    <value>(</value>
                                    <evalStatement>
                                        <evalStringType>
                                            <value>"%.2f"</value>
                                        </evalStringType>
                                    </evalStatement>
                                </subEvalStatement>
                            </evalStatement>
                            <value>*</value>
                            <evalStatement>
                                <evalFunctionStatement>
                                    <evalMethodPow>
                                        <value>pow</value>
                                        <value>(</value>
                                        <evalStatement>
                                            <evalFieldType>
                                                <value>r</value>
                                            </evalFieldType>
                                        </evalStatement>
                                        <value>,</value>
                                        <evalStatement>
                                            <evalNumberType>
                                                <value>2</value>
                                            </evalNumberType>
                                        </evalStatement>
                                        <value>)</value>
                                    </evalMethodPow>
                                </evalFunctionStatement>
                            </evalStatement>
                        </evalStatement>
                    </t_eval_evalParameter>
                </evalTransformation>
            </transformStatement>
        </transformStatement>
    </transformStatement>
</root>
