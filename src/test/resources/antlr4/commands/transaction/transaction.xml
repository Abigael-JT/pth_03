<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root>
    <transformStatement>
        <value>|</value>
        <transactionTransformation>
            <value>transaction</value>
            <fieldListType>
                <fieldType>
                    <value>foo</value>
                </fieldType>
                <fieldType>
                    <value>bar</value>
                </fieldType>
            </fieldListType>
            <t_transaction_tnxOptions>
                <t_transaction_maxeventsParameter>
                    <value>maxevents=</value>
                    <integerType>
                        <value>100</value>
                    </integerType>
                </t_transaction_maxeventsParameter>
            </t_transaction_tnxOptions>
            <t_transaction_tnxOptions>
                <t_transaction_unifyendsParameter>
                    <value>unifyends=</value>
                    <booleanType>
                        <value>T</value>
                    </booleanType>
                </t_transaction_unifyendsParameter>
            </t_transaction_tnxOptions>
            <t_transaction_tnxOptions>
                <t_transaction_endswithParameter>
                    <value>endswith=</value>
                    <t_transaction_transamFilterStringParameter>
                        <value>eval(</value>
                        <evalStatement>
                            <evalStatement>
                                <evalFieldType>
                                    <value>first</value>
                                </evalFieldType>
                            </evalStatement>
                            <value>!=</value>
                            <evalStatement>
                                <evalFieldType>
                                    <value>last</value>
                                </evalFieldType>
                            </evalStatement>
                        </evalStatement>
                        <value>)</value>
                    </t_transaction_transamFilterStringParameter>
                </t_transaction_endswithParameter>
            </t_transaction_tnxOptions>
        </transactionTransformation>
        <transformStatement>
            <EOF/>
        </transformStatement>
    </transformStatement>
</root>