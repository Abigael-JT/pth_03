<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root>
    <value>|</value>
    <transformStatement>
        <joinTransformation>
            <value>join</value>
            <t_join_joinOptionsParameter>
                <t_join_typeParameter>
                    <value>type=</value>
                    <value>left</value>
                </t_join_typeParameter>
            </t_join_joinOptionsParameter>
            <t_join_joinOptionsParameter>
                <t_join_usetimeParameter>
                    <value>usetime=</value>
                    <booleanType>
                        <value>f</value>
                    </booleanType>
                </t_join_usetimeParameter>
            </t_join_joinOptionsParameter>
            <t_join_joinOptionsParameter>
                <t_join_overwriteParameter>
                    <value>overwrite=</value>
                    <booleanType>
                        <value>t</value>
                    </booleanType>
                </t_join_overwriteParameter>
            </t_join_joinOptionsParameter>
            <t_join_joinOptionsParameter>
                <t_join_earlierParameter>
                    <value>earlier=</value>
                    <booleanType>
                        <value>f</value>
                    </booleanType>
                </t_join_earlierParameter>
            </t_join_joinOptionsParameter>
            <t_join_joinOptionsParameter>
                <t_join_maxParameter>
                    <value>max=</value>
                    <integerType>
                        <value>8</value>
                    </integerType>
                </t_join_maxParameter>
            </t_join_joinOptionsParameter>
            <fieldListType>
                <fieldType>
                    <value>jejeje</value>
                </fieldType>
                <value>,</value>
                <fieldType>
                    <value>dddd</value>
                </fieldType>
            </fieldListType>
            <t_join_unnamedDatasetParameter>
                <subsearchStatement>
                    <value>[</value>
                    <transformStatement>
                        <addinfoTransformation>
                            <value>addinfo</value>
                        </addinfoTransformation>
                    </transformStatement>
                    <value>]</value>
                </subsearchStatement>
            </t_join_unnamedDatasetParameter>
        </joinTransformation>
    </transformStatement>
</root>