<root>
    <transformStatement>
        <value>|</value>
        <rtorderTransformation>
            <value>rtorder</value>
            <t_rtorder_discardParameter>
                <value>discard=</value>
                <booleanType>
                    <value>f</value>
                </booleanType>
            </t_rtorder_discardParameter>
            <t_rtorder_bufferSpanParameter>
                <value>buffer_span=</value>
                <spanType>
                    <value>2H</value>
                </spanType>
            </t_rtorder_bufferSpanParameter>
            <t_rtorder_maxBufferSizeParameter>
                <value>max_buffer_size=</value>
                <integerType>
                    <value>10</value>
                </integerType>
            </t_rtorder_maxBufferSizeParameter>
        </rtorderTransformation>
        <transformStatement>
            <EOF/>
        </transformStatement>
    </transformStatement>
</root>
 
